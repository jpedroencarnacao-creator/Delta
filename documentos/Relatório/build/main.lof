\contentsline {figure}{\numberline {3.1}{\ignorespaces Laboratório de impressão 3D da universidade, com as impressoras Creality utilizadas nas fases iniciais de impressão do protótipo.}}{10}{figure.caption.12}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Primeiro teste de impressão da árvore brônquica em PLA branco, março de 2026. São visíveis as marcas dos suportes e as zonas mais frágeis nas junções entre ramos.}}{11}{figure.caption.13}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Impressão da árvore brônquica em filamento flexível na impressora Bambu Lab, maio de 2026. O modelo ocupa a maior parte da cama de impressão (\(350\times 320\times 325\,\text {mm}^3\)).}}{11}{figure.caption.14}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Servo motor com suporte impresso em 3D para validação do acoplamento mecânico com a estrutura do manipulador delta, março de 2026.}}{12}{figure.caption.15}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Caixa impressa em PLA branco que aloja o Raspberry Pi 4B e a fonte de alimentação comutada, junho de 2026.}}{14}{figure.caption.17}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Estrutura mecânica de um manipulador delta em PLA preto, antes da instalação dos servos, maio de 2026. A base circular e os três braços articulados estão já montados.}}{15}{figure.caption.18}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Os dois manipuladores delta montados com os servos Waveshare instalados, prontos para calibração de firmware, junho de 2026. Os cabos dos servos são visíveis mas ainda sem organização final de cablagem.}}{16}{figure.caption.19}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Esquema consolidado de alimentação, comunicação e comando dos dois manipuladores delta.}}{16}{figure.caption.20}%
